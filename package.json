{
    "name": "sonicwave",
    "version": "1.0.0",
    "description": "Canvas audio waveform visualizer, interactive equalizer bars and frequency spectrum display. WaveSurfer.js alternative. Zero dependencies.",
    "main": "src/sonicwave.js",
    "module": "src/sonicwave.js",
    "type": "module",
    "files": [
        "src/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "esbuild src/sonicwave.js --bundle --minify --format=esm --outfile=dist/sonicwave.min.js",
        "dev": "esbuild src/sonicwave.js --bundle --format=esm --outfile=dist/sonicwave.js --watch"
    },
    "keywords": [
        "waveform",
        "audio",
        "visualization",
        "equalizer",
        "spectrum",
        "canvas",
        "sonicmotion"
    ],
    "author": "axscq",
    "license": "MIT",
    "devDependencies": {
        "esbuild": "^0.20.0"
    }
}